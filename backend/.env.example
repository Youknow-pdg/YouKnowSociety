# ============================================================================
# YOU KNOW CORE (/backend) — Variables d'environnement (modèle sans secrets)
# Copiez ce fichier vers `.env` (ignoré par Git) et renseignez vos vraies valeurs.
# ============================================================================

NODE_ENV="development"
PORT="4000"

# Domaine officiel & CORS multi-frontends (React, Angular, Flutter)
PRIMARY_DOMAIN="https://youknowgroup.com"
CORS_ALLOWED_ORIGINS="https://youknowgroup.com,https://www.youknowgroup.com,https://admin.youknowgroup.com,https://academy.youknowgroup.com,https://api.youknowgroup.com,http://localhost:3000,http://localhost:5173,http://localhost:4200"

# Base MySQL centrale via Prisma
# ATTENTION : Si le mot de passe contient des caractères spéciaux (ex: , / @ : #), encodez-les en URL (%2C %2F %40 %3A %23)
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@HOST:3306/youknow_core_db"

# Sécurité JWT & Sessions
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"

# Stockage fichiers local persistant (en dehors de dist/)
STORAGE_ROOT="./storage"

# Hostinger Mail SMTP
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contact@youknowgroup.com"
SMTP_PASS="REPLACE_WITH_HOSTINGER_MAIL_PASSWORD"
SMTP_FROM="YOU KNOW GROUP <contact@youknowgroup.com>"
