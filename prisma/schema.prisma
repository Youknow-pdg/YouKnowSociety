// ============================================================================
// YOU KNOW DATABASE — Schéma Prisma Central (YOU KNOW CORE)
// Base : MySQL (Hostinger) | Domaine : https://youknowgroup.com
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  HOLDING
  SUBSIDIARY
  ACADEMY
  PARTNER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ClientPlatform {
  REACT_WEB
  ANGULAR_WEB
  FLUTTER_MOBILE
  ADMIN_CONSOLE
  API_CLIENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectRole {
  LEAD
  DEVELOPER
  DESIGNER
  TRAINER
  ANALYST
  OBSERVER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CourseCategory {
  BUREAUTIQUE
  IA_TECH
  DEV_WEB
  ENTREPRENEURIAT
  AUTRE
}

enum DeliveryMode {
  ONLINE
  HYBRID
  IN_PERSON
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AppType {
  file
  link
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

model Organization {
  id              String           @id @default(uuid()) @db.Char(36)
  code            String           @unique @db.VarChar(40)
  name            String           @db.VarChar(160)
  slug            String           @unique @db.VarChar(120)
  type            OrganizationType @default(SUBSIDIARY)
  parentId        String?          @map("parent_id") @db.Char(36)
  sector          String?          @db.VarChar(120)
  domain          String?          @db.VarChar(190)
  email           String?          @db.VarChar(190)
  phone           String?          @db.VarChar(50)
  defaultCurrency String           @default("XOF") @map("default_currency") @db.Char(3)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime?        @map("deleted_at") @db.DateTime(3)

  parent               Organization?          @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children             Organization[]         @relation("OrgHierarchy")
  users                User[]                 @relation("UserPrimaryOrg")
  userRoles            UserRole[]
  projects             Project[]
  financialCategories  FinancialCategory[]
  budgets              Budget[]
  transactions         FinancialTransaction[]
  courses              Course[]
  applications         Application[]
  documents            Document[]
  notifications        Notification[]

  @@index([parentId])
  @@index([isActive, deletedAt])
  @@map("organizations")
}

model User {
  id                    String     @id @default(uuid()) @db.Char(36)
  email                 String     @unique @db.VarChar(190)
  passwordHash          String     @map("password_hash") @db.VarChar(255)
  fullName              String     @map("full_name") @db.VarChar(160)
  phone                 String?    @db.VarChar(50)
  primaryOrganizationId String?    @map("primary_organization_id") @db.Char(36)
  status                UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt       DateTime?  @map("email_verified_at") @db.DateTime(3)
  lastLoginAt           DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt             DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt             DateTime?  @map("deleted_at") @db.DateTime(3)

  primaryOrganization  Organization?          @relation("UserPrimaryOrg", fields: [primaryOrganizationId], references: [id], onDelete: SetNull)
  profile              UserProfile?
  verifications        EmailVerification[]
  sessions             Session[]
  userRoles            UserRole[]             @relation("RoleAssignee")
  assignedRoles        UserRole[]             @relation("RoleAssigner")
  managedProjects      Project[]              @relation("ProjectManager")
  projectMemberships   ProjectMember[]
  createdBudgets       Budget[]
  createdTransactions  FinancialTransaction[] @relation("TransactionCreator")
  approvedTransactions FinancialTransaction[] @relation("TransactionApprover")
  enrollments          Enrollment[]
  uploadedDocuments    Document[]
  notifications        Notification[]
  forumTopics          ForumTopic[]
  forumReplies         ForumReply[]

  @@index([status, deletedAt])
  @@index([primaryOrganizationId])
  @@map("users")
}

model UserProfile {
  userId          String   @id @map("user_id") @db.Char(36)
  avatarUrl       String?  @map("avatar_url") @db.VarChar(500)
  jobTitle        String?  @map("job_title") @db.VarChar(150)
  bio             String?  @db.Text
  city            String?  @default("Dakar") @db.VarChar(100)
  country         String?  @default("Sénégal") @db.VarChar(100)
  language        String   @default("fr") @db.VarChar(10)
  preferencesJson Json?    @map("preferences_json")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model EmailVerification {
  id         String              @id @default(uuid()) @db.Char(36)
  userId     String              @map("user_id") @db.Char(36)
  tokenHash  String              @unique @map("token_hash") @db.VarChar(128)
  purpose    VerificationPurpose @default(EMAIL_VERIFY)
  expiresAt  DateTime            @map("expires_at") @db.DateTime(3)
  consumedAt DateTime?           @map("consumed_at") @db.DateTime(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_verifications")
}

model Session {
  id               String         @id @default(uuid()) @db.Char(36)
  userId           String         @map("user_id") @db.Char(36)
  clientPlatform   ClientPlatform @default(REACT_WEB) @map("client_platform")
  refreshTokenHash String         @unique @map("refresh_token_hash") @db.VarChar(128)
  ipAddress        String?        @map("ip_address") @db.VarChar(64)
  userAgent        String?        @map("user_agent") @db.VarChar(500)
  expiresAt        DateTime       @map("expires_at") @db.DateTime(3)
  revokedAt        DateTime?      @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Char(36)
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(60)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  roleId         String   @map("role_id") @db.Char(36)
  organizationId String?  @map("organization_id") @db.Char(36)
  assignedBy     String?  @map("assigned_by") @db.Char(36)
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  user         User          @relation("RoleAssignee", fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assigner     User?         @relation("RoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, organizationId])
  @@index([organizationId])
  @@map("user_roles")
}

model Project {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String        @map("organization_id") @db.Char(36)
  code           String        @db.VarChar(50)
  name           String        @db.VarChar(180)
  description    String?       @db.Text
  status         ProjectStatus @default(ACTIVE)
  managerId      String?       @map("manager_id") @db.Char(36)
  startDate      DateTime?     @map("start_date") @db.Date
  endDate        DateTime?     @map("end_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?     @map("deleted_at") @db.DateTime(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  manager      User?                  @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  budgets      Budget[]
  transactions FinancialTransaction[]
  documents    Document[]

  @@unique([organizationId, code])
  @@index([organizationId, status, deletedAt])
  @@index([managerId])
  @@map("projects")
}

model ProjectMember {
  id          String      @id @default(uuid()) @db.Char(36)
  projectId   String      @map("project_id") @db.Char(36)
  userId      String      @map("user_id") @db.Char(36)
  projectRole ProjectRole @default(DEVELOPER) @map("project_role")
  joinedAt    DateTime    @default(now()) @map("joined_at") @db.DateTime(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model FinancialCategory {
  id             String          @id @default(uuid()) @db.Char(36)
  organizationId String?         @map("organization_id") @db.Char(36)
  code           String          @db.VarChar(50)
  name           String          @db.VarChar(140)
  type           TransactionType
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgets      Budget[]
  transactions FinancialTransaction[]

  @@unique([organizationId, code])
  @@index([type, isActive])
  @@map("financial_categories")
}

model Budget {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @map("organization_id") @db.Char(36)
  projectId       String?  @map("project_id") @db.Char(36)
  categoryId      String?  @map("category_id") @db.Char(36)
  fiscalYear      Int      @map("fiscal_year")
  fiscalMonth     Int?     @map("fiscal_month") @db.TinyInt
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(18, 2)
  currency        String   @default("XOF") @db.Char(3)
  notes           String?  @db.VarChar(500)
  createdBy       String   @map("created_by") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category     FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator      User               @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, projectId, categoryId, fiscalYear, fiscalMonth])
  @@index([organizationId, fiscalYear])
  @@map("budgets")
}

model FinancialTransaction {
  id                 String            @id @default(uuid()) @db.Char(36)
  organizationId     String            @map("organization_id") @db.Char(36)
  projectId          String?           @map("project_id") @db.Char(36)
  type               TransactionType
  categoryId         String            @map("category_id") @db.Char(36)
  amount             Decimal           @db.Decimal(18, 2)
  currency           String            @default("XOF") @db.Char(3)
  baseCurrency       String            @default("XOF") @map("base_currency") @db.Char(3)
  exchangeRate       Decimal           @default(1.000000) @map("exchange_rate") @db.Decimal(14, 6)
  baseCurrencyAmount Decimal           @map("base_currency_amount") @db.Decimal(18, 2)
  status             TransactionStatus @default(PENDING)
  transactionDate    DateTime          @map("transaction_date") @db.DateTime(3)
  referenceCode      String?           @map("reference_code") @db.VarChar(80)
  description        String?           @db.Text
  idempotencyKey     String?           @map("idempotency_key") @db.VarChar(100)
  createdBy          String            @map("created_by") @db.Char(36)
  approvedBy         String?           @map("approved_by") @db.Char(36)
  approvedAt         DateTime?         @map("approved_at") @db.DateTime(3)
  rejectionReason    String?           @map("rejection_reason") @db.VarChar(500)
  createdAt          DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt          DateTime?         @map("deleted_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category     FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator      User              @relation("TransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver     User?             @relation("TransactionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, referenceCode])
  @@index([organizationId, transactionDate, status])
  @@index([projectId, type, status])
  @@index([categoryId])
  @@index([createdBy])
  @@index([approvedBy])
  @@map("financial_transactions")
}

model Course {
  id                 String         @id @default(uuid()) @db.Char(36)
  organizationId     String         @map("organization_id") @db.Char(36)
  code               String         @unique @db.VarChar(50)
  title              String         @db.VarChar(200)
  category           CourseCategory @default(IA_TECH)
  deliveryMode       DeliveryMode   @default(ONLINE) @map("delivery_mode")
  durationDays       Int            @default(21) @map("duration_days")
  registrationFeeXof Decimal        @default(5000.00) @map("registration_fee_xof") @db.Decimal(12, 2)
  perSessionFeeXof   Decimal        @default(1475.00) @map("per_session_fee_xof") @db.Decimal(12, 2)
  description        String?        @db.Text
  isPublished        Boolean        @default(true) @map("is_published")
  createdAt          DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  enrollments  Enrollment[]

  @@index([organizationId, isPublished])
  @@map("courses")
}

model Enrollment {
  id              String           @id @default(uuid()) @db.Char(36)
  courseId        String           @map("course_id") @db.Char(36)
  userId          String?          @map("user_id") @db.Char(36)
  learnerName     String           @map("learner_name") @db.VarChar(160)
  learnerEmail    String           @map("learner_email") @db.VarChar(190)
  learnerPhone    String?          @map("learner_phone") @db.VarChar(50)
  status          EnrollmentStatus @default(PENDING)
  certificateCode String?          @unique @map("certificate_code") @db.VarChar(80)
  enrolledAt      DateTime         @default(now()) @map("enrolled_at") @db.DateTime(3)
  completedAt     DateTime?        @map("completed_at") @db.DateTime(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([courseId, status])
  @@index([userId])
  @@map("enrollments")
}

model Application {
  id                       String   @id @db.VarChar(120)
  organizationId           String?  @map("organization_id") @db.Char(36)
  name                     String   @db.VarChar(160)
  subtitle                 String   @db.VarChar(255)
  category                 String   @db.VarChar(120)
  subsidiary               String   @default("YOU KNOW TECH") @db.VarChar(120)
  appType                  AppType  @default(link) @map("app_type")
  platform                 String   @db.VarChar(120)
  fileUrl                  String?  @map("file_url") @db.VarChar(500)
  fileName                 String?  @map("file_name") @db.VarChar(255)
  fileSize                 String?  @map("file_size") @db.VarChar(60)
  sizeBytes                BigInt?  @default(0) @map("size_bytes")
  url                      String?  @db.VarChar(500)
  isIframePreviewable      Boolean  @default(true) @map("is_iframe_previewable")
  targetAudience           String?  @map("target_audience") @db.VarChar(255)
  description              String   @db.Text
  highlightsJson           Json?    @map("highlights_json")
  techStackJson            Json?    @map("tech_stack_json")
  status                   String   @default("En ligne") @db.VarChar(80)
  badgeText                String?  @map("badge_text") @db.VarChar(100)
  isSpotlight              Boolean  @default(false) @map("is_spotlight")
  imagePlaceholderGradient String?  @map("image_placeholder_gradient") @db.VarChar(120)
  createdAt                DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, appType])
  @@index([isSpotlight])
  @@map("applications")
}

model ForumCategory {
  id          String       @id @db.VarChar(50)
  name        String       @db.VarChar(100)
  description String?      @db.Text
  icon        String?      @db.VarChar(50)
  color       String?      @db.VarChar(50)
  orderNum    Int          @default(0) @map("order_num")
  topics      ForumTopic[]

  @@map("forum_categories")
}

model ForumTopic {
  id           Int           @id @default(autoincrement())
  categoryId   String        @map("category_id") @db.VarChar(50)
  authorUserId String?       @map("author_user_id") @db.Char(36)
  title        String        @db.VarChar(255)
  content      String        @db.Text
  authorName   String        @map("author_name") @db.VarChar(100)
  authorRole   String        @default("Membre") @map("author_role") @db.VarChar(100)
  authorAvatar String?       @map("author_avatar") @db.VarChar(255)
  views        Int           @default(0)
  likes        Int           @default(0)
  isPinned     Int           @default(0) @map("is_pinned") @db.TinyInt
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamp(0)

  category ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  replies  ForumReply[]

  @@index([categoryId, isPinned, createdAt])
  @@map("forum_topics")
}

model ForumReply {
  id           Int        @id @default(autoincrement())
  topicId      Int        @map("topic_id")
  authorUserId String?    @map("author_user_id") @db.Char(36)
  content      String     @db.Text
  authorName   String     @map("author_name") @db.VarChar(100)
  authorRole   String     @default("Membre") @map("author_role") @db.VarChar(100)
  authorAvatar String?    @map("author_avatar") @db.VarChar(255)
  likes        Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(0)

  topic  ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User?      @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([topicId, createdAt])
  @@map("forum_replies")
}

model Document {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  projectId      String?  @map("project_id") @db.Char(36)
  uploadedBy     String?  @map("uploaded_by") @db.Char(36)
  module         String   @default("GENERAL") @db.VarChar(60)
  entityId       String?  @map("entity_id") @db.VarChar(120)
  originalName   String   @map("original_name") @db.VarChar(255)
  storagePath    String   @map("storage_path") @db.VarChar(500)
  mimeType       String   @map("mime_type") @db.VarChar(160)
  sizeBytes      BigInt   @map("size_bytes")
  sha256Checksum String   @map("sha256_checksum") @db.Char(64)
  isPublic       Boolean  @default(false) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploader     User?        @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, module])
  @@index([projectId])
  @@map("documents")
}

model Notification {
  id             String              @id @default(uuid()) @db.Char(36)
  userId         String              @map("user_id") @db.Char(36)
  organizationId String?             @map("organization_id") @db.Char(36)
  channel        NotificationChannel @default(IN_APP)
  type           String              @db.VarChar(80)
  title          String              @db.VarChar(200)
  body           String              @db.Text
  linkUrl        String?             @map("link_url") @db.VarChar(500)
  isRead         Boolean             @default(false) @map("is_read")
  readAt         DateTime?           @map("read_at") @db.DateTime(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String?  @map("organization_id") @db.Char(36)
  actorUserId    String?  @map("actor_user_id") @db.Char(36)
  actorLabel     String?  @map("actor_label") @db.VarChar(160)
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String   @map("entity_id") @db.VarChar(120)
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model SystemSetting {
  settingKey   String   @id @map("setting_key") @db.VarChar(120)
  settingValue String   @map("setting_value") @db.Text
  isPublic     Boolean  @default(false) @map("is_public")
  description  String?  @db.VarChar(255)
  updatedBy    String?  @map("updated_by") @db.Char(36)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("system_settings")
}
